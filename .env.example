# Pick ONE (or none for demo mode + the free chatbot import).
# FREE: Google Gemini key from https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=
# PAID: Claude key from https://console.anthropic.com (used first if both are set)
ANTHROPIC_API_KEY=

# Optional
# AI_PROVIDER=gemini            # force a provider: gemini | anthropic
# GEMINI_MODEL=                 # override the auto-picked Gemini model for building units
# GEMINI_LIGHT_MODEL=           # override the auto-picked model for grading/tutor
# CLAUDE_MODEL=claude-opus-5-5
# PORT=3000
# AI_CALLS_PER_HOUR=80
# DATA_DIR=./data
# NODE_ENV=production
